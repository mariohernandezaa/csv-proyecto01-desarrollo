# Copiar a ".env" en la raíz del proyecto (junto a docker-compose.yml) y
# rellenar los valores necesarios. Este fichero nunca debe subirse al repositorio.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
APP_URL=http://localhost:8080
